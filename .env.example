POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
GROQ_API_KEY=

# --- Production hardening (all optional locally) ---
# local | test | production. production hides /docs and requires GROQ_API_KEY
# and a CORS_ORIGINS without '*'.
APP_ENV=local
# Comma-separated browser origins allowed to call the API. Empty = no CORS headers.
CORS_ORIGINS=
# Public self-registration. Off by default; create tenants with
# backend/scripts/seed_tenant.py. Turned on only as the last step of the project.
ALLOW_PUBLIC_REGISTRATION=false
